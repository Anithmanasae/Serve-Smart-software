{
  "expo": {
    "name": "Smart Serve",
    "slug": "sada-pos",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "sadapos",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartserve"
    },
    "android": {
      "package": "com.smartserve",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#00336F"
      },
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./plugins/withBluetoothPermissions",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smart Serve to access your photos to set menu item images.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#00336F"
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0047A1"
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "145c354b-c767-4274-af17-891a5442ddc3"
      }
    },
    "owner": "cornerstonesoftware"
  }
}
