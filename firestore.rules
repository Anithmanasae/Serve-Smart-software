rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Smart Serve — Firestore Security Rules (multi-tenant SaaS)
//
// With no Cloud Functions, THESE RULES ARE THE SERVER-SIDE SECURITY BOUNDARY.
// They run on Google's servers and cannot be bypassed by tampering with the
// client. Every money-sensitive invariant lives here:
//   - roles are read from the user's profile doc, never from the client payload
//   - waiters cannot finalize/pay bills; only cashiers/admins can
//   - paid bills are immutable, except a reprint and a same-day cancellation
//   - quantities/prices/totals must be non-negative and internally consistent
//   - a bill becomes NON-CHARGEABLE only at settle, only with a valid reason,
//     and never while rewriting its totals — a comp cannot hide its own cost

//   - kitchen/cashier can only advance KOT status, nothing else
//   - self-signup only creates PENDING waiter/kitchen profiles — and only with
//     the restaurant's real join code; the cashier approves them. Exactly one
//     cashier can ever self-claim per restaurant via meta/bootstrap.
//   - pending/denied/restricted accounts can read nothing but their own profile
//   - TRIAL EXPIRY: every NEW restaurant is born as a 2-day trial, with its
//     start stamped by the SERVER (trialStartedAt == request.time, satisfiable
//     only by a serverTimestamp sentinel). The deadline is computed, not
//     stored. An explicit `expiresAt` overrides it, and is Admin-SDK-only.
//     NO TRIAL FIELDS = NEVER EXPIRES, so every existing (permanent) account
//     is completely unaffected by this ruleset, and activating a paying
//     customer is simply DELETING the fields. Clients can never write, change
//     or clear either one.
//
// MULTI-TENANT: every app doc lives under restaurants/{restaurantId}, and every
// role check reads the caller's profile under THAT restaurant — a member of
// restaurant A resolves to no profile in restaurant B, so every cross-tenant
// read or write dies in activeProfile(). Two top-level lookup collections
// (userIndex, restaurantCodes) are write-once and bound to real membership via
// getAfter, so neither can ever point somewhere the writer doesn't belong.
//
// A brand-new restaurant is born in ONE atomic owner-registration batch:
//   restaurants/{rid}            root profile (name + joinCode + trialStartedAt)
//   restaurants/{rid}/meta/bootstrap   { cashierClaimed: true }
//   restaurants/{rid}/users/{uid}      the owner's approved+active CASHIER
//   restaurantCodes/{joinCode}         → { restaurantId }
//   userIndex/{uid}                    → { restaurantId }
// Each doc's create rule getAfter()s the others, so none can be created alone.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- userIndex/{uid} (top-level): which restaurant a login belongs to --
    // Readable only by that login (get, never list). Created exactly once, by
    // the account itself, and only when the same batch (or an earlier one)
    // gives that account a users profile inside the named restaurant — an
    // index entry can never point at a restaurant the user isn't a member of.
    // Immutable afterwards: an account can never re-point itself at another
    // restaurant.
    match /userIndex/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['restaurantId'])
        && request.resource.data.restaurantId is string
        && getAfter(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/users/$(uid)).data.uid == uid;
      allow update, delete: if false;
    }

    // ---- restaurantCodes/{code} (top-level): join-code → restaurant --------
    // Any signed-in user may GET one code (that's how the join flow resolves
    // the code it was given) but never LIST them — codes can't be harvested.
    // Created only inside the owner-registration batch: the code must match
    // the new restaurant root's joinCode and the creator must come out of the
    // batch as that restaurant's approved cashier. Immutable afterwards, so a
    // code can never be re-pointed and (create-on-existing = update = denied)
    // two restaurants can never share a code.
    match /restaurantCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['restaurantId'])
        && request.resource.data.restaurantId is string
        && getAfter(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.joinCode == code
        && getAfter(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/users/$(request.auth.uid)).data.role == 'cashier'
        && getAfter(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/users/$(request.auth.uid)).data.status == 'approved';
      allow update, delete: if false;
    }

    match /restaurants/{restaurantId} {

      // ---- helpers -------------------------------------------------------

      function signedIn() {
        return request.auth != null;
      }

      // Role is read from the caller's own profile document (server-side),
      // so a client cannot claim a role it doesn't have. Scoped to THIS
      // restaurant: a member of another restaurant has no profile here, so
      // every role check below fails for them.
      function profile() {
        return get(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)).data;
      }

      // ---- trial expiry ----------------------------------------------------
      // ABSENT FIELDS = NEVER EXPIRES. This is the whole safety property: a
      // permanent restaurant carries neither `trialStartedAt` nor `expiresAt`,
      // so every check below short-circuits to true and no timestamp
      // comparison is even evaluated. The checks are never written the other
      // way round ("expiresAt must be in the future"), because that form locks
      // out every existing account the moment it deploys.
      //
      // Compared against request.time — GOOGLE'S clock, evaluated server-side.
      // Changing the device date, reinstalling, or clearing app storage cannot
      // move it.
      //
      // TWO MECHANISMS, in precedence order:
      //
      //  1. `trialStartedAt` — SELF-SERVE trials. Stamped by the SERVER at
      //     registration: the create rule below demands the field equal
      //     request.time, which only a serverTimestamp() sentinel can satisfy.
      //     A client cannot backdate it, cannot forge a longer window, and
      //     cannot omit it. The deadline is COMPUTED (start + trialLength), so
      //     there is no stored expiry for anyone to tamper with, and no
      //     client-supplied timestamp means no clock-skew window to defend.
      //
      //  2. `expiresAt` — an explicit deadline that OVERRIDES the computed one.
      //     Writable only through the Admin SDK (which bypasses rules), i.e.
      //     scripts/seedTrial.js and the activation tooling. This is how a
      //     custom trial length or a paid-through subscription date is set.
      //
      // Activation = DELETING both fields, which is why "no field" must always
      // mean "permanent". Never replace this with an isPaid flag: absence
      // cannot drift out of sync with reality, a boolean can.
      //
      // Expiry is checked at BOTH levels and either one closes the account:
      //   tenant  restaurants/{rid}   — the workspace as a whole
      //   account users/{uid}         — the individual login
      // The tenant field is what makes this airtight: without it, anyone who
      // can create a user doc inside the trial (an admin, or a fresh join-code
      // signup) could mint a seat with no expiry and keep the workspace alive
      // past the deadline.
      function restaurantDoc() {
        return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
      }

      /** How long a self-serve trial runs. THE one place to change it — it is
       *  applied to trialStartedAt at read time, so editing this and deploying
       *  re-times every trial in flight (including ones already expired). */
      function trialLength() {
        return duration.value(2, 'd');
      }

      // Explicit expiresAt wins; else the computed trial deadline; else the
      // tenant is permanent. Repeated restaurantDoc() calls resolve to ONE
      // document read — Firestore caches identical get()s within a single rule
      // evaluation.
      function tenantNotExpired() {
        return ('expiresAt' in restaurantDoc())
          ? restaurantDoc().expiresAt > request.time
          : (!('trialStartedAt' in restaurantDoc())
             || restaurantDoc().trialStartedAt + trialLength() > request.time);
      }

      function selfNotExpired() {
        return !('expiresAt' in profile())
          || profile().expiresAt > request.time;
      }

      function notExpired() {
        return tenantNotExpired() && selfNotExpired();
      }

      // No client may add, change, or CLEAR a trial field on a doc it can edit.
      // Clearing is the dangerous one: without the first clause a trial admin
      // could strip the trial cashier's expiry, or a trial cashier could strip
      // the waiter's and kitchen's, and keep a seat past the deadline. Worse,
      // on the ROOT doc, clearing trialStartedAt IS activation — a cashier
      // could hand themselves a permanent restaurant for free. Only the Admin
      // SDK (which bypasses rules entirely) may write these fields.
      //
      // Each is written as two mutually exclusive shapes — "absent on both
      // sides" or "present on both sides AND equal" — so the comparison is only
      // reached when BOTH maps actually carry the key. Reading a missing field
      // is an evaluation error in rules; it still denies, but a clean false is
      // easier to trust and keeps the audit logs readable.
      function expiresAtUnchanged() {
        return (!('expiresAt' in resource.data)
                && !('expiresAt' in request.resource.data))
          || (('expiresAt' in resource.data)
              && ('expiresAt' in request.resource.data)
              && request.resource.data.expiresAt == resource.data.expiresAt);
      }

      // Only ever present on the ROOT doc. On a users/{uid} write both sides
      // lack it, so this is trivially true and costs nothing.
      function trialStartedAtUnchanged() {
        return (!('trialStartedAt' in resource.data)
                && !('trialStartedAt' in request.resource.data))
          || (('trialStartedAt' in resource.data)
              && ('trialStartedAt' in request.resource.data)
              && request.resource.data.trialStartedAt == resource.data.trialStartedAt);
      }

      function expiryUnchanged() {
        return expiresAtUnchanged() && trialStartedAtUnchanged();
      }

      // An admin creating a staff account must pass its OWN expiry down: a
      // trial admin cannot mint a permanent (no-expiresAt) colleague and hand
      // itself an unlimited seat. A permanent admin creates permanent accounts,
      // exactly as before. Only reachable from the isAdmin() create branch, so
      // profile() is guaranteed to exist when this runs.
      function creatorExpiryInherited() {
        return ('expiresAt' in profile())
          ? request.resource.data.expiresAt == profile().expiresAt
          : !('expiresAt' in request.resource.data);
      }

      // A usable account = cashier-approved signup that isn't restricted today
      // and whose trial (if any) hasn't run out.
      function activeProfile() {
        return profile().status == 'approved'
          && profile().active == true
          && notExpired();
      }

      function hasRole(role) {
        return signedIn() && activeProfile() && profile().role == role;
      }

      function hasAnyRole(roles) {
        return signedIn() && activeProfile() && profile().role in roles;
      }

      // Baseline for all app-data reads. Pending/denied/restricted logins can
      // resolve their own profile doc but see no restaurant data.
      function isActiveStaff() {
        return signedIn() && activeProfile();
      }

      function isAdmin() {
        return hasRole('admin');
      }

      // Is the caller a member (any status) of THIS restaurant?
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid));
      }

      function rootPath() {
        return /databases/$(database)/documents/restaurants/$(restaurantId);
      }

      function bootstrapPath() {
        return /databases/$(database)/documents/restaurants/$(restaurantId)/meta/bootstrap;
      }

      function selfUserPath() {
        return /databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid);
      }

      function incomingDiffers(fields) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(fields);
      }

      function validProfileName() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }

      // ---- NON-CHARGEABLE ("NC") bills ------------------------------------
      // A comped bill: nothing collected, and the client keeps it out of every
      // sales figure. ABSENT/false = an ordinary chargeable bill, so a bill is
      // only ever free because someone explicitly said so.
      function isNc(data) {
        return 'nonChargeable' in data && data.nonChargeable == true;
      }

      // ---- OFFERS on a bill ------------------------------------------------
      // `subtotal` stays GROSS of offers, so the offer total has to fit inside
      // it: a discount larger than the food is a broken bill, and a negative
      // one is a surcharge wearing a promotion's clothes.
      //
      // ABSENT is allowed and means zero — bills written before offers existed
      // carry no such field, and an order that matched no promotion has
      // nothing to record. Same "absence is the safe default" property the
      // trial fields rely on: the safe reading is the one you get by default.
      //
      // Note what this does NOT do: it never checks that the amount matches
      // any offer document. It cannot — offers change, and a bill must keep
      // the terms it was priced under. The ceiling is the honest guarantee.
      function validOfferDiscount() {
        return !('offerDiscount' in request.resource.data)
          || (request.resource.data.offerDiscount is int
              && request.resource.data.offerDiscount >= 0
              && request.resource.data.offerDiscount
                 <= request.resource.data.subtotal);
      }

      // NC may be applied ONLY on the settle write, and that write must
      // PRESERVE what the comp was worth. Without the three equality checks a
      // cashier could zero the totals on the way out and the owner's NC report
      // would read Rs.0 — the comp would be free to give AND invisible.
      //
      // 'void' is allowed alongside 'paid' because a comped bill can still be
      // CANCELLED (validVoidUpdate below) — and this function guards that write
      // too, so the comp's recorded value survives the cancellation intact.
      function validNcUpdate() {
        return !isNc(request.resource.data)
          || (
            request.resource.data.status in ['paid', 'void']
            && request.resource.data.paymentMode == null
            && request.resource.data.ncReason in
               ['owner', 'staff', 'complaint', 'pr', 'other']
            && (
              !('ncNote' in request.resource.data)
              || (request.resource.data.ncNote is string
                  && request.resource.data.ncNote.size() <= 140)
            )
            && request.resource.data.subtotal == resource.data.subtotal
            && request.resource.data.gstTotal == resource.data.gstTotal
            && request.resource.data.grandTotal == resource.data.grandTotal
            // Pinned for the same reason as the three above: a comp write must
            // not be able to rewrite what the OFFERS on the bill were worth,
            // or the day's promo cost could be zeroed on the way out. get()
            // with a default keeps this working on bills that predate offers,
            // where the field is missing from both sides.
            && request.resource.data.get('offerDiscount', 0)
               == resource.data.get('offerDiscount', 0)
          );
      }

      // ---- CANCELLED ("VOID") bills ---------------------------------------
      // The IST calendar date of a timestamp (+05:30). Firestore rules have no
      // timezone support, so shift then take the date — this is the rules-side
      // twin of dayKey() in src/lib/date.ts, and the two must agree.
      function istDate(t) {
        return (t + duration.value(330, 'm')).date();
      }

      // Cancelling a settled bill: 'paid' -> 'void', and NOTHING else may move.
      //
      // incomingDiffers() is what makes this safe: the void write cannot carry
      // a changed grandTotal, gstTotal, paymentMode or nonChargeable alongside
      // it, so a cancellation can never be used to rewrite what the sale was
      // worth. Requiring the PRIOR status to be 'paid' makes void terminal —
      // a bill cannot be cancelled twice, which is what stops the client from
      // decrementing the day's summary more than once.
      //
      // voidedBy is pinned to the caller and voidedAt to request.time (only a
      // serverTimestamp() sentinel satisfies that — the same trick that starts
      // the trial clock), so neither the actor nor the moment can be forged.
      //
      // The same-day check is the load-bearing one: a day the owner has already
      // read can never change underneath them.
      function validVoidUpdate() {
        return resource.data.status == 'paid'
          && request.resource.data.status == 'void'
          && incomingDiffers(
               ['status', 'voidedAt', 'voidedBy', 'voidReason', 'voidNote'])
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidedAt == request.time
          && request.resource.data.voidReason in
             ['bad-food', 'wrong-order', 'customer-complaint',
              'billing-error', 'other']
          && (
            !('voidNote' in request.resource.data)
            || (request.resource.data.voidNote is string
                && request.resource.data.voidNote.size() <= 140)
          )
          && istDate(resource.data.paidAt) == istDate(request.time);
      }

      // The owner-registration batch, verified from the root-profile CREATE
      // (so request.resource here is the incoming root doc): the new profile
      // carries a well-formed joinCode, the matching restaurantCodes lookup
      // points back HERE, the registrant comes out of the batch as this
      // restaurant's approved+active cashier with the seat claimed, and their
      // userIndex points here. getAfter ties them together — none of these
      // docs can be created without the others landing in the same commit.
      function isOwnerRegistrationBatch() {
        return signedIn()
          && request.resource.data.joinCode is string
          && request.resource.data.joinCode.size() >= 4
          && request.resource.data.joinCode.size() <= 12
          && getAfter(/databases/$(database)/documents/restaurantCodes/$(request.resource.data.joinCode)).data.restaurantId == restaurantId
          && getAfter(selfUserPath()).data.role == 'cashier'
          && getAfter(selfUserPath()).data.status == 'approved'
          && getAfter(selfUserPath()).data.active == true
          && getAfter(bootstrapPath()).data.cashierClaimed == true
          && getAfter(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.restaurantId == restaurantId;
      }

      // ---- restaurant profile (this ROOT doc) ------------------------------
      // Holds the receipt header { name, addressLine?, updatedAt } plus the
      // staff joinCode. Readable by this restaurant's members only (it prints
      // on every bill; pending staff may resolve the name too) — NOT by other
      // restaurants' users, so join codes can't be harvested cross-tenant.
      //
      // CREATE is the owner-registration chicken-and-egg: there is no
      // admin/cashier yet, so the registrant may create the root doc only as
      // part of the full atomic registration batch (verified via getAfter).
      // UPDATE stays admin/cashier-only and can never change the joinCode —
      // the restaurantCodes/{code} lookup is immutable, so the pair can't
      // drift apart.
      //
      // EVERY NEW RESTAURANT IS BORN AS A TRIAL. `trialStartedAt` is mandatory
      // on create and must equal request.time, so the SERVER decides when the
      // clock starts — the only way a client can satisfy this is by sending a
      // serverTimestamp() sentinel. It cannot backdate the field, cannot skip
      // it, and cannot supply a deadline of its own (`expiresAt` stays banned
      // here — that override is Admin-SDK-only). Making the trial the DEFAULT,
      // rather than something the app opts into, means no build of the client
      // can register itself a permanent restaurant. Activation happens later,
      // from the Admin SDK, by deleting these fields.
      allow get: if isMember();
      allow list: if false;
      // The `in` check comes FIRST so an omitted stamp denies with a clean
      // false rather than an evaluation error ("Property trialStartedAt is
      // undefined on object"). Both deny; only one is readable in the audit log.
      allow create: if validProfileName()
        && !('expiresAt' in request.resource.data)
        && ('trialStartedAt' in request.resource.data)
        && request.resource.data.trialStartedAt == request.time
        && isOwnerRegistrationBatch();
      allow update: if hasAnyRole(['admin', 'cashier'])
        && validProfileName()
        && expiryUnchanged()
        && (!('joinCode' in resource.data)
            || request.resource.data.joinCode == resource.data.joinCode);
      allow delete: if false;

      // ---- users ---------------------------------------------------------
      // Anyone signed in can read their own profile (needed to resolve role
      // and to watch for approval). Admin + cashier read the whole staff list.
      //
      // Self-signup:
      //  - waiter/kitchen create their OWN profile as pending+inactive, and
      //    must present this restaurant's joinCode (checked server-side
      //    against the root doc) — a client that doesn't know the code cannot
      //    plant a profile here. The cashier must approve before the account
      //    can do anything.
      //  - the owner's cashier profile self-claims by atomically creating an
      //    approved cashier profile AND flipping meta/bootstrap
      //    cashierClaimed false→true in one batch (the owner-registration
      //    batch). Once claimed, this branch can never pass again for this
      //    restaurant — one owner seat per restaurant, ever.
      //
      // Management: the cashier approves/denies/restricts/deletes waiter and
      // kitchen profiles only — never admin or cashier profiles, and can never
      // promote anyone out of waiter/kitchen.
      match /users/{uid} {
        allow read: if signedIn()
          && (request.auth.uid == uid || hasAnyRole(['admin', 'cashier']));

        // Self-signup branches may never carry an expiresAt (a client would
        // only ever set one on itself to something harmless). They don't need
        // to: a signup into a trial workspace is caught by tenantNotExpired().
        allow create: if (isAdmin() && creatorExpiryInherited())
          // waiter/kitchen self-signup — always lands pending + inactive, and
          // only with this restaurant's real join code
          || (signedIn() && request.auth.uid == uid
              && !('expiresAt' in request.resource.data)
              && request.resource.data.role in ['waiter', 'kitchen']
              && request.resource.data.status == 'pending'
              && request.resource.data.active == false
              && request.resource.data.joinCode == get(rootPath()).data.joinCode)
          // one-time cashier claim — must set the claim flag in the same batch
          || (signedIn() && request.auth.uid == uid
              && !('expiresAt' in request.resource.data)
              && request.resource.data.role == 'cashier'
              && request.resource.data.status == 'approved'
              && request.resource.data.active == true
              && !(exists(bootstrapPath())
                   && get(bootstrapPath()).data.cashierClaimed == true)
              && getAfter(bootstrapPath()).data.cashierClaimed == true
              // the restaurant must exist after this batch (created in it, or
              // pre-existing) — no cashier claims on a phantom restaurant
              && getAfter(rootPath()).data.name is string);

        // expiryUnchanged() is factored OUT of the || so it binds to BOTH
        // branches. The cashier branch never restricted which keys it could
        // affect, so without this a cashier could rewrite a waiter/kitchen doc
        // wholesale and simply drop expiresAt; an admin could do it to anyone.
        allow update: if expiryUnchanged()
          && (
            isAdmin()
            || (hasRole('cashier')
                && resource.data.role in ['waiter', 'kitchen']
                && request.resource.data.role in ['waiter', 'kitchen']
                && request.resource.data.status in ['pending', 'approved', 'denied']
                && request.resource.data.active is bool)
          );

        allow delete: if isAdmin()
          || (hasRole('cashier') && resource.data.role in ['waiter', 'kitchen']);
      }

      // ---- meta/bootstrap (one-time cashier claim flag) -------------------
      // Readable by any signed-in user (it holds a single boolean and nothing
      // sensitive). Writes may only flip it to true in the same batch that
      // creates the claimant's own cashier profile (verified via getAfter),
      // so the flag can't be set — or reset — on its own by a non-admin.
      match /meta/bootstrap {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['cashierClaimed'])
          && request.resource.data.cashierClaimed == true
          && getAfter(selfUserPath()).data.role == 'cashier';
        allow update: if signedIn()
          && resource.data.cashierClaimed == false
          && request.resource.data.keys().hasOnly(['cashierClaimed'])
          && request.resource.data.cashierClaimed == true
          && getAfter(selfUserPath()).data.role == 'cashier';
        allow delete: if isAdmin();
      }

      // ---- menu ----------------------------------------------------------
      // Everyone signed in reads the menu; admins and cashiers edit it
      // (cashiers manage the day's menu from their Account screen).
      // Delete is split out because request.resource does not exist on
      // delete requests, so the price check would wrongly deny them.
      match /menuCategories/{categoryId} {
        allow read: if isActiveStaff();
        allow create, update: if hasAnyRole(['admin', 'cashier']);
        allow delete: if hasAnyRole(['admin', 'cashier']);
      }
      match /menuItems/{itemId} {
        allow read: if isActiveStaff();
        allow create, update: if hasAnyRole(['admin', 'cashier'])
          && request.resource.data.price is int
          && request.resource.data.price >= 0;
        allow delete: if hasAnyRole(['admin', 'cashier']);
      }

      // ---- offers (product discounts) ------------------------------------
      // The owner's promotions: BOGO, combo prices, "Monday Madness". EVERY
      // active staff member reads them, because the waiter's order screen
      // prices the cart against them live — but only admin/cashier may write
      // one, exactly like the menu whose prices they modify.
      //
      // This is NOT the manual bill discount: that stays banned outright (see
      // the bills rules below, where discountPercent/discountAmount are pinned
      // to zero). An offer is decided in advance by the owner and applies to a
      // product; a till-side percentage is decided by whoever is holding the
      // cash. Only the first is trustworthy, so only the first exists.
      //
      // The amount fields are range-checked here so a bad write cannot plant a
      // negative or absurd discount that the pricing engine would then stamp
      // onto every order. `enabled` is the day-to-day switch and `priority`
      // only ever breaks ties, so neither needs more than a type check.
      match /offers/{offerId} {
        allow read: if isActiveStaff();
        allow create, update: if hasAnyRole(['admin', 'cashier'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.kind in ['percent', 'flat', 'bogo', 'bundle']
          && request.resource.data.enabled is bool
          && request.resource.data.priority is int
          && request.resource.data.itemIds is list
          && request.resource.data.categoryIds is list
          && (!('percentOff' in request.resource.data)
              || (request.resource.data.percentOff is int
                  && request.resource.data.percentOff >= 0
                  && request.resource.data.percentOff <= 100))
          && (!('amountOff' in request.resource.data)
              || (request.resource.data.amountOff is int
                  && request.resource.data.amountOff >= 0))
          && (!('buyQty' in request.resource.data)
              || (request.resource.data.buyQty is int
                  && request.resource.data.buyQty >= 1))
          && (!('freeQty' in request.resource.data)
              || (request.resource.data.freeQty is int
                  && request.resource.data.freeQty >= 1))
          && (!('bundleQty' in request.resource.data)
              || (request.resource.data.bundleQty is int
                  && request.resource.data.bundleQty >= 1))
          && (!('bundlePrice' in request.resource.data)
              || (request.resource.data.bundlePrice is int
                  && request.resource.data.bundlePrice >= 0));
        allow delete: if hasAnyRole(['admin', 'cashier']);
      }

      // ---- tables --------------------------------------------------------
      // Floor staff read tables and update occupancy/merge/shift status.
      // The cashier (restaurant owner) sizes the floor from Account → Tables,
      // so create/delete is admin + cashier (never waiter/kitchen).
      match /tables/{tableId} {
        allow read: if isActiveStaff();
        allow create, delete: if hasAnyRole(['admin', 'cashier']);
        allow update: if hasAnyRole(['admin', 'waiter', 'cashier']);
      }

      // ---- orders --------------------------------------------------------
      // Waiters and cashiers create/edit orders (cashiers take takeaway at
      // the counter); admins too. Subtotal must be a non-negative int.
      match /orders/{orderId} {
        allow read: if isActiveStaff();
        allow create: if hasAnyRole(['admin', 'waiter', 'cashier'])
          && request.resource.data.subtotal is int
          && request.resource.data.subtotal >= 0;
        allow update: if hasAnyRole(['admin', 'waiter', 'cashier'])
          && request.resource.data.subtotal is int
          && request.resource.data.subtotal >= 0;
        allow delete: if isAdmin();
      }

      // ---- KOTs ----------------------------------------------------------
      // Floor staff (waiter/cashier) create tickets. Kitchen and cashier can
      // ONLY advance status/printedCount, never edit items or prices.
      match /kots/{kotId} {
        allow read: if isActiveStaff();
        allow create: if hasAnyRole(['admin', 'waiter', 'cashier']);
        allow update: if isAdmin()
          || (hasAnyRole(['kitchen', 'cashier'])
              && incomingDiffers(['status', 'printedCount', 'updatedAt']))
          || (hasRole('waiter')
              && incomingDiffers(['printedCount', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // ---- bills ---------------------------------------------------------
      // A waiter may only REQUEST a bill. Finalizing, taking payment, and
      // marking paid are cashier/admin only. MANUAL discounts do not exist:
      // every bill must carry discountPercent == 0 and discountAmount == 0, so
      // nobody at the till can decide to knock money off a total. The owner's
      // pre-configured OFFERS are the sanctioned path and arrive separately in
      // `offerDiscount` (validOfferDiscount()), capped by the subtotal. Paid
      // bills are immutable apart from a reprint and a same-day cancellation
      // (validVoidUpdate()). Totals must be internally consistent and
      // non-negative. A bill is never BORN non-chargeable — NC can only arrive
      // on the settle write, under validNcUpdate().
      match /bills/{billId} {
        allow read: if isActiveStaff();

        // A waiter may only REQUEST a bill. Cashier/admin may also open it
        // straight to 'finalized'. New bills are never created already paid,
        // and never already comped.
        allow create: if request.resource.data.grandTotal is int
          && request.resource.data.grandTotal >= 0
          && request.resource.data.discountPercent == 0
          && request.resource.data.discountAmount == 0
          && validOfferDiscount()
          && !isNc(request.resource.data)
          && request.resource.data.gstTotal ==
             request.resource.data.cgst + request.resource.data.sgst
          && (
            (hasRole('waiter') && request.resource.data.status == 'requested')
            || (hasAnyRole(['admin', 'cashier'])
                && request.resource.data.status in ['requested', 'finalized'])
          );

        // Only cashier/admin finalize and settle. Once paid or void the bill
        // is frozen — EXCEPT a reprint may bump printedCount, and a bill paid
        // TODAY may be cancelled. validNcUpdate() applies to ALL branches: it
        // is a no-op on an ordinary bill, and on a comped one it holds through
        // reprints and cancellation too, so the recorded value of a comp cannot
        // be rewritten under cover of either.
        allow update: if hasAnyRole(['admin', 'cashier'])
          && validNcUpdate()
          && (
            // reprint: printedCount-only change, allowed in any status
            incomingDiffers(['printedCount'])
            // cancel a settled bill: paid -> void, same IST business day
            || validVoidUpdate()
            || (
              resource.data.status != 'paid'
              && resource.data.status != 'void'
              && request.resource.data.grandTotal is int
              && request.resource.data.grandTotal >= 0
              && request.resource.data.discountPercent == 0
              && request.resource.data.discountAmount == 0
              && validOfferDiscount()
              && request.resource.data.gstTotal ==
                 request.resource.data.cgst + request.resource.data.sgst
            )
          );

        allow delete: if isAdmin();
      }

      // ---- counters (KOT ticket #, bill #) ------------------------------
      // Sequential human-facing numbers, incremented in a transaction by
      // floor/cashier staff. Value must be a non-negative int.
      match /counters/{name} {
        allow read: if isActiveStaff();
        allow write: if hasAnyRole(['admin', 'waiter', 'cashier'])
          && request.resource.data.value is int
          && request.resource.data.value >= 0;
      }

      // ---- daily summaries (reports) ------------------------------------
      // Readable by admin/cashier. Written by the client on payment; guarded
      // so only cashier/admin can mutate aggregates.
      match /dailySummaries/{date} {
        allow read: if hasAnyRole(['admin', 'cashier']);
        allow write: if hasAnyRole(['admin', 'cashier']);
      }

      // Deny everything not explicitly matched above.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
