{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    // Expo's base sets customConditions: ["react-native"], which stops @types/node
    // from resolving via exports. The Node-only shims under scripts/ need it.
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    // Cloud Functions are a separate Node package with their own tsconfig,
    // dependencies and target. Type-check them with `npm --prefix functions
    // run build`; pulling them in here only produces missing-module noise for
    // packages the app deliberately does not depend on.
    "functions"
  ]
}
