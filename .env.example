# Firebase web config — copy to `.env.local` and fill from
# Firebase console > Project settings > General > Your apps > Web app.
# Expo exposes only vars prefixed EXPO_PUBLIC_* to the app at build time.
# These are public client identifiers (safe to ship); real protection is
# Firestore Security Rules + Firebase Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The single restaurant/tenant this deployment serves.
EXPO_PUBLIC_RESTAURANT_ID=sada-main

# PostHog product analytics (optional — leave blank to turn analytics off).
# PostHog > Project settings > Project token (starts with phc_). It's a public
# write-only key, safe to ship in the app.
EXPO_PUBLIC_POSTHOG_KEY=
# US cloud by default; use https://eu.i.posthog.com for an EU project.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
