# Firebase web config — copy to `.env.local` and fill from
# Firebase console > Project settings > General > Your apps > Web app.
# Expo exposes only vars prefixed EXPO_PUBLIC_* to the app at build time.
# These are public client identifiers (safe to ship); real protection is
# Firestore Security Rules + Firebase Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The single restaurant/tenant this deployment serves.
EXPO_PUBLIC_RESTAURANT_ID=sada-main
