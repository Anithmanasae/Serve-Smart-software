# Firebase web config — copy to `.env.local` and fill from
# Firebase console > Project settings > General > Your apps > Web app.
# Expo exposes only vars prefixed EXPO_PUBLIC_* to the app at build time.
# These are public client identifiers (safe to ship); real protection is
# Firestore Security Rules + Firebase Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dev-build fallback tenant only — the real restaurant is resolved at runtime
# from userIndex/{uid}. One build serves every restaurant.
EXPO_PUBLIC_RESTAURANT_ID=sada-main

# Demo/trial builds only (set by the `demo` EAS profile — see eas.json).
# "true" hides self-signup so a prospect can't register their own restaurant
# mid-demo, and shows a DEMO BUILD chip on the login screen so you can confirm
# at a glance which build you're holding. LEAVE THIS UNSET FOR PRODUCTION.
# Not a security control — the trial is enforced server-side by expiresAt in
# firestore.rules. See scripts/seedTrial.js.
# EXPO_PUBLIC_DEMO_MODE=true
