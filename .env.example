# Firebase web config — copy to `.env.local` and fill from
# Firebase console > Project settings > General > Your apps > Web app.
# Expo exposes only vars prefixed EXPO_PUBLIC_* to the app at build time.
# These are public client identifiers (safe to ship); real protection is
# Firestore Security Rules + Firebase Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dev-build fallback tenant only — the real restaurant is resolved at runtime
# from userIndex/{uid}. One build serves every restaurant.
EXPO_PUBLIC_RESTAURANT_ID=sada-main

# Who a locked-out trial contacts to activate — YOU. Shown on the "trial
# ended" screen and the Account trial card, and opened as a WhatsApp chat with
# a pre-filled message carrying their signup email (which is what
# scripts/activateTenant.js needs to find them).
#
# Digits only: country code, no "+", no spaces. With no number set, the app
# simply omits the button rather than opening a broken link.
EXPO_PUBLIC_CONTACT_PHONE=919876543210
EXPO_PUBLIC_CONTACT_NAME=Smart Serve

# Test builds only (set by the `demo` EAS profile — see eas.json). Shows a
# TEST BUILD chip with the Firebase project id on the login screen, so you can
# confirm at a glance which backend the APK talks to. LEAVE UNSET FOR
# PRODUCTION.
#
# It no longer changes any behaviour: every new restaurant is a 2-day trial,
# enforced server-side in firestore.rules, so the same APK serves prospects and
# paying customers alike.
# EXPO_PUBLIC_DEMO_MODE=true
